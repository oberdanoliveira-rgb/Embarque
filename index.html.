<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leitor de Embarque - GitHub Pages</title>
  <script src="https://unpkg.com/html5-qrcode"></script>
  <style>
    body { font-family: Arial, sans-serif; text-align: center; margin: 15px; background: #f4f4f9; }
    h2 { color: #333; margin-bottom: 10px; }
    #reader { width: 100%; max-width: 360px; margin: 10px auto; background: #fff; border-radius: 8px; padding: 10px; }
    #status { margin-top: 15px; font-size: 1.1em; font-weight: bold; padding: 12px; border-radius: 5px; }
    .sucesso { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .erro { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    .processando { background: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
  </style>
</head>
<body>
  <h2>Embarque de Alunos</h2>
  <div id="reader"></div>
  <div id="status">Aguardando permissão da câmera...</div>

  <script>
    // COLE AQUI A URL DO SEU APPS SCRIPT
    const APPS_SCRIPT_URL = 'SUA_URL_DO_APPS_SCRIPT_AQUI';

    let processando = false;

    function enviarCodigo(codigo) {
      if (processando) return;
      processando = true;

      const statusDiv = document.getElementById('status');
      statusDiv.innerText = 'Processando: ' + codigo;
      statusDiv.className = 'processando';

      fetch(APPS_SCRIPT_URL, {
        method: 'POST',
        mode: 'cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ codigo: codigo })
      })
      .then(response => response.json())
      .then(res => {
        if (res.sucesso) {
          statusDiv.innerText = '✅ EMBARCADO: ' + res.nome;
          statusDiv.className = 'sucesso';
        } else {
          statusDiv.innerText = '❌ ' + res.mensagem;
          statusDiv.className = 'erro';
        }
      })
      .catch(err => {
        statusDiv.innerText = '❌ Erro de conexão com a planilha.';
        statusDiv.className = 'erro';
      })
      .finally(() => {
        setTimeout(() => { processando = false; }, 2000); // Aguarda 2s antes de ler novamente
      });
    }

    const html5QrCode = new Html5Qrcode("reader");

    Html5Qrcode.getCameras().then(devices => {
      if (devices && devices.length) {
        // Usa a câmera traseira do celular
        let cameraId = devices[devices.length - 1].id;
        html5QrCode.start(
          cameraId, 
          { fps: 10, qrbox: { width: 250, height: 250 } },
          (decodedText) => enviarCodigo(decodedText)
        ).catch(err => {
          document.getElementById('status').innerText = '❌ Erro ao iniciar câmera: ' + err;
          document.getElementById('status').className = 'erro';
        });
      } else {
        document.getElementById('status').innerText = '❌ Nenhuma câmera encontrada.';
        document.getElementById('status').className = 'erro';
      }
    }).catch(err => {
      document.getElementById('status').innerText = '❌ Permissão negada pelo navegador.';
      document.getElementById('status').className = 'erro';
    });
  </script>
</body>
</html>
